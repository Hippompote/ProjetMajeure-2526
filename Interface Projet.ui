  <property name="styleSheet">
   <string notr="true">QLabel {
    color: white;             /* ou un code hexa : #FFFFFF */
    background-color: transparent;
}

/* --- FOND GENERAL --- */
QMainWindow, QWidget {
    background-color: #2e3035; /* Gris sombre industriel */
    color: #ffffff;            /* Texte blanc par défaut */
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 11pt;           /* Gros texte lisible (style tactile) */
}

/* --- LES TEXTES (LABELS) --- */
QLabel {
    color: #f0f0f0;
    font-weight: bold;
    background: transparent;
}

/* Spécifique pour ton titre ou l'heure (si tu lui donnes un nom spécifique) */
QLabel#label_titre {
    color: #a87eeb; /* Un violet type &quot;TGV Inoui&quot; pour le titre */
    font-size: 11pt;
}

/* --- BOUTONS COMPACTS --- */
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #6c717d, stop:1 #52565e);
    border: 1px solid #3e4147; /* Bordure plus fine (1px au lieu de 2px) */
    border-radius: 6px;        /* Arrondi plus petit (6px au lieu de 10px) */
    
    color: white;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    
    /* C'EST ICI QUE TU REGLES LA TAILLE : */
    font-size: 10pt;           /* Texte plus petit (avant: 14pt) */
    padding: 5px 15px;         /* Moins d'espace autour du texte (avant: 10px 20px) */
    
    /* Optionnel : Forcer une hauteur fixe si tu veux qu'ils soient tous pareils */
    min-height: 25px;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7d8290, stop:1 #60646e);
    border-color: #a87eeb;
}

QPushButton:pressed {
    background-color: #3e4147;
    padding-top: 6px;  /* Ajusté pour le nouveau padding */
    padding-bottom: 4px;
}

/* Effet au survol de la souris */
QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7d8290, stop:1 #60646e);
    border-color: #a87eeb;     /* Bordure violette au survol */
}

/* Effet quand on clique */
QPushButton:pressed {
    background-color: #3e4147; /* Plus sombre pour simuler l'enfoncement */
    padding-top: 12px;         /* Décalage du texte pour l'effet physique */
    padding-bottom: 8px;
}

/* --- LE SLIDER --- */
QSlider::groove:horizontal {
    border: 1px solid #3e4147;
    height: 10px;
    background: #1e1f22;
    margin: 2px 0;
    border-radius: 5px;
}

QSlider::handle:horizontal {
    background: #ffbe00;       /* Le Jaune SNCF iconique pour le curseur */
    border: 1px solid #1e1f22;
    width: 24px;
    height: 24px;
    margin: -8px 0;
    border-radius: 12px;       /* Curseur rond */
}

/* Style spécifique pour le GRAND TITRE */
QLabel#label_titre {
    color: #a87eeb;      /* Violet SNCF */
    font-size: 12pt;     /* Très gros */
    font-weight: bold;
    text-transform: uppercase; /* Force les majuscules */
    border-bottom: 2px solid #a87eeb; /* Une ligne soulignée stylée */
}</string>
